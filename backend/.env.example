# Copy this file to .env and fill in your values
# Never commit .env to version control

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# JWT token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Google OAuth
# Register at https://console.cloud.google.com/apis/credentials
# Set redirect URI to: http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# URL where your frontend is served (for CORS in production)
FRONTEND_URL=http://localhost:5500
